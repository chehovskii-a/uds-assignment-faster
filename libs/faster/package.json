{
  "name": "@chehovskii-a/faster",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chehovskii-a/uds-assignment-faster.git",
    "directory": "libs/faster"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ],
    "#/*.css": "./src/*.css"
  },
  "exports": {
    "./package.json": "./package.json",
    "./index.css": {
      "@faster/source": "./src/styles.css",
      "default": "./dist/index.css"
    },
    ".": {
      "@faster/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:ui"
    ]
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  }
}
